# ローカルE2E専用Neon branch。Preview staging DBやProduction DBは指定しない。
DATABASE_URL=postgresql://user:password@e2e-branch.example/dbname
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
SENTRY_DSN=
VITE_SENTRY_DSN=
ADMIN_CRON_SECRET=
# ローカルE2E専用。Cloudflare Pages Preview / Productionではfalseにする。
E2E_TEST_MODE=true
